# Automatically generate Ansible inventory file after provisioning EC2 instances
resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/hosts.ini"
  file_permission = "0644"
  content         = <<-EOT
# ==============================================================================
# Ansible Inventory - Auto-generated by Terraform
# Project: ${var.project_name} | Environment: ${var.environment}
# ==============================================================================

[app_servers]
app-server ansible_host=${aws_instance.app_server.public_ip} private_ip=${aws_instance.app_server.private_ip}

[monitoring_servers]
monitoring-server ansible_host=${aws_instance.monitoring_server.public_ip} private_ip=${aws_instance.monitoring_server.private_ip}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${local.ssh_key_path}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
ansible_python_interpreter=/usr/bin/python3

# Cross-server reference variables for dynamic configuration
app_server_public_ip=${aws_instance.app_server.public_ip}
app_server_private_ip=${aws_instance.app_server.private_ip}
monitoring_server_public_ip=${aws_instance.monitoring_server.public_ip}
monitoring_server_private_ip=${aws_instance.monitoring_server.private_ip}
EOT
}
