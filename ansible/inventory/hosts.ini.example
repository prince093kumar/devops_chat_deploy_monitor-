# ==============================================================================
# Sample Ansible Inventory
# Note: When running 'terraform apply', this file is automatically generated at
# ansible/inventory/hosts.ini with real EC2 public IPs!
# ==============================================================================

[app_servers]
app-server ansible_host=54.210.10.100 private_ip=172.31.10.100

[monitoring_servers]
monitoring-server ansible_host=54.210.10.200 private_ip=172.31.10.200

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=id_rsa_devops
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
ansible_python_interpreter=/usr/bin/python3

app_server_public_ip=54.210.10.100
app_server_private_ip=172.31.10.100
monitoring_server_public_ip=54.210.10.200
monitoring_server_private_ip=172.31.10.200

