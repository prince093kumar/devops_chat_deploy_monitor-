# Custom Command Definitions for Microservices & NRPE Monitoring
# Auto-generated by Ansible

# Command to execute remote NRPE checks on the Application Server
define command {
    command_name    check_nrpe
    command_line    /usr/lib/nagios/plugins/check_nrpe -H $HOSTADDRESS$ -c $ARG1$
}

# Command to check specific HTTP port and URI path
define command {
    command_name    check_http_port_url
    command_line    /usr/lib/nagios/plugins/check_http -H $HOSTADDRESS$ -p $ARG1$ -u $ARG2$ -t 15
}

# Command to check specific HTTP port with expected string
define command {
    command_name    check_http_port_string
    command_line    /usr/lib/nagios/plugins/check_http -H $HOSTADDRESS$ -p $ARG1$ -u $ARG2$ -s "$ARG3$" -t 15
}

