# Host Definitions for Chat Microservices App Server
# Auto-generated by Ansible

define host {
    use                     generic-host
    host_name               app-server
    alias                   Chat Microservices Application Server
    address                 {{ app_server_private_ip | default(app_server_public_ip) }}
    check_command           check-host-alive
    max_check_attempts      {{ nagios_max_check_attempts | default(2) }}
    check_interval          {{ nagios_check_interval | default(1) }}
    retry_interval          {{ nagios_retry_interval | default(1) }}
    check_period            24x7
    notification_interval   {{ nagios_notification_interval | default(30) }}
    notification_period     24x7
    notification_options    d,u,r
    contact_groups          microchat_admins
}

define hostgroup {
    hostgroup_name          chat-application-servers
    alias                   Microservices Application Cluster
    members                 app-server
}

