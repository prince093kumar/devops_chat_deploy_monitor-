version: '3.8'

# Dynamic override generated by Ansible
# Injects current server IP: {{ ansible_host }}
# Exposes microservice ports for direct Nagios monitoring and health checks
# When use_dockerhub_images=true, pulls pre-built backend images from Docker Hub

services:
  gateway:
{% if use_dockerhub_images | default(false) | bool %}
    image: "{{ dockerhub_username }}/microchat-gateway:{{ docker_image_tag | default('latest') }}"
{% endif %}
    environment:
      - CLIENT_URL=http://{{ ansible_host }}:3000
    restart: unless-stopped

  client:
    build:
      args:
        - VITE_API_URL=http://{{ ansible_host }}:5000
    restart: unless-stopped

  auth-service:
{% if use_dockerhub_images | default(false) | bool %}
    image: "{{ dockerhub_username }}/microchat-auth-service:{{ docker_image_tag | default('latest') }}"
{% endif %}
    ports:
      - "5001:5001"
    restart: unless-stopped

  chat-service:
{% if use_dockerhub_images | default(false) | bool %}
    image: "{{ dockerhub_username }}/microchat-chat-service:{{ docker_image_tag | default('latest') }}"
{% endif %}
    ports:
      - "5002:5002"
    restart: unless-stopped

  notification-service:
{% if use_dockerhub_images | default(false) | bool %}
    image: "{{ dockerhub_username }}/microchat-notification-service:{{ docker_image_tag | default('latest') }}"
{% endif %}
    ports:
      - "5003:5003"
    restart: unless-stopped

