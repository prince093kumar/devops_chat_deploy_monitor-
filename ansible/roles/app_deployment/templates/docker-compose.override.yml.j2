version: '3.8'

# Dynamic override generated by Ansible
# Injects current server IP: {{ ansible_host }}
# Exposes microservice ports for direct Nagios monitoring and health checks

services:
  gateway:
    environment:
      - CLIENT_URL=http://{{ ansible_host }}:3000
    restart: unless-stopped

  client:
    build:
      args:
        - VITE_API_URL=http://{{ ansible_host }}:5000
    restart: unless-stopped

  auth-service:
    ports:
      - "5001:5001"
    restart: unless-stopped

  chat-service:
    ports:
      - "5002:5002"
    restart: unless-stopped

  notification-service:
    ports:
      - "5003:5003"
    restart: unless-stopped
